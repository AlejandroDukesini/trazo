# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# PostgreSQL 16+ (extensión citext disponible)
DATABASE_URL=postgres://trazo:CAMBIAR@localhost:5432/trazo_dev
# Solo para `pnpm test` (se borra y recrea en cada ejecución)
TEST_DATABASE_URL=postgres://trazo:CAMBIAR@localhost:5432/trazo_test
# URL pública de la web (enlaces de correo y retorno de pagos)
APP_URL=http://localhost:5173
# Orígenes adicionales permitidos (Capacitor Android y Tauri Windows)
CORS_ORIGINS=http://localhost:5173,https://localhost,http://tauri.localhost,https://tauri.localhost
# true detrás de un proxy inverso (X-Forwarded-For)
TRUST_PROXY=false
UPLOAD_DIR=./uploads
# Correo saliente. Sin él, en desarrollo los correos se escriben en el log.
# SMTP_URL=smtps://usuario:clave@smtp.proveedor.com:465
# MAIL_FROM=Trazo <no-reply@tu-dominio>
# Rutas automáticas (https://openrouteservice.org, plan gratuito 2000 req/día)
# ORS_API_KEY=
# Geocodificación (por defecto el servicio público de Photon)
# PHOTON_URL=https://photon.komoot.io
# Pagos web (Stripe, usar claves de modo test en desarrollo)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PLUS_MONTH=price_...
# STRIPE_PRICE_PLUS_YEAR=price_...
