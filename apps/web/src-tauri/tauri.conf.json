{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trazo",
  "version": "0.1.0",
  "identifier": "app.trazo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:native"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trazo",
        "width": 1320,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http://localhost:* http://127.0.0.1:*",
        "font-src": "'self' data: https://tiles.openfreemap.org",
        "connect-src": "'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "SportsGame",
    "shortDescription": "Registra, analiza y comparte tus entrenamientos",
    "copyright": "© Trazo",
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Spanish", "English"] },
      "wix": { "language": ["es-ES"] }
    }
  }
}
